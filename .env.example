# Copy this file to .env and fill in your own values.
# Port the server listens on.
PORT=3000

# Shared secret required on write requests (POST/PUT/DELETE to /api/items,
# and POST to /api/command). Leave blank while developing on your own
# machine/LAN. Set this before exposing the server via Tailscale/port-forward
# so Siri/Alexa webhooks (and anyone else) need the token to change anything.
API_TOKEN=

# Google Calendar sync (optional). See README for how to obtain these via
# a Google Cloud project + OAuth consent screen + refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
